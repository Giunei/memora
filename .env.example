# ---------------------------------------------------------------------------
# Memora - local development environment
# Copy to `.env` and adjust. `.env` is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

# --- PostgreSQL (consumed by docker-compose and by the backend) -------------
POSTGRES_DB=memora
POSTGRES_USER=memora
POSTGRES_PASSWORD=memora_local_password
POSTGRES_PORT=5432

# Full JDBC URL used by the backend. Inside docker-compose the host is `postgres`.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/memora
SPRING_DATASOURCE_USERNAME=memora
SPRING_DATASOURCE_PASSWORD=memora_local_password

# --- Authentication ---------------------------------------------------------
# HMAC-SHA256 signing secret for access tokens. MUST be at least 32 bytes.
# Generate one with: openssl rand -base64 48
MEMORA_SECURITY_JWT_SECRET=change-me-this-is-only-valid-for-local-development-32b+

# Access token lifetime (ISO-8601 duration). Keep it short; refresh handles the rest.
MEMORA_SECURITY_JWT_ACCESS_TOKEN_TTL=PT15M

# Refresh token lifetime (ISO-8601 duration).
MEMORA_SECURITY_REFRESH_TOKEN_TTL=P30D

# Set to true only when the app is served over HTTPS (production).
MEMORA_SECURITY_COOKIE_SECURE=false

# --- CORS -------------------------------------------------------------------
# Not needed when the Angular dev-server proxy is used (same origin).
# Only set this if the frontend is served from a different origin.
MEMORA_SECURITY_ALLOWED_ORIGINS=

# --- AI (optional, Gemini) --------------------------------------------------
# The platform is fully functional with AI disabled. Never commit a real key.
MEMORA_AI_ENABLED=false
GEMINI_API_KEY=
MEMORA_AI_GEMINI_MODEL=gemini-2.5-flash
MEMORA_AI_REQUEST_TIMEOUT=PT30S
MEMORA_AI_DAILY_REQUEST_LIMIT_PER_USER=20
